# 외부 클라우드 단독 배포 설정 예시 (shopping_mall/.env)
MALL_MODE=cloud
OBS_PULL_ENABLED=0
MALL_PORT=3000

# 방송자 PC 로컬 라이브 에이전트와 동일하게 맞출 연동 시크릿 키
MALL_SYNC_SECRET=change-this-secret-key

# 로컬 에이전트 하트비트 만료 시간(초) — 방송 PC 강제 종료 시 자동 오프라인 전환
MALL_HEARTBEAT_TIMEOUT_SEC=35

# 2-도메인 공개 URL 설정
MALL_PUBLIC_URL=http://localhost:3000
STUDIO_PUBLIC_URL=http://localhost:5000

# 도메인 2 쇼핑몰 보안 및 초기 관리자 설정 (미설정 시 난수 자동 생성)
MALL_SECRET_KEY=
MALL_ADMIN_EMAIL=admin@mall.local
MALL_ADMIN_PASSWORD=
