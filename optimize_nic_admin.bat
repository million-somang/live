@echo off
chcp 65001 >nul
echo ============================================================================
echo [Intel I219-V 랜카드 2~3시간 방송 끊김(TX Ring Hang) 영구 방지 및 보조 DNS 설정]
echo ============================================================================
powershell -NoProfile -ExecutionPolicy Bypass -Command "if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { Start-Process powershell -ArgumentList '-NoProfile -ExecutionPolicy Bypass -Command \"Set-NetAdapterAdvancedProperty -Name ''이더넷'' -RegistryKeyword ''*LsoV2IPv4'' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name ''이더넷'' -RegistryKeyword ''*LsoV2IPv6'' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name ''이더넷'' -RegistryKeyword ''EEELinkAdvertisement'' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name ''이더넷'' -RegistryKeyword ''ULPMode'' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name ''이더넷'' -RegistryKeyword ''*SelectiveSuspend'' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name ''이더넷'' -RegistryKeyword ''ReduceSpeedOnPowerDown'' -RegistryValue 0 -NoRestart; Set-DnsClientServerAddress -InterfaceAlias ''이더넷'' -ServerAddresses (''192.168.1.1'',''8.8.8.8'',''1.1.1.1''); Restart-NetAdapter -Name ''이더넷'' -Confirm:$false\"' -Verb RunAs } else { Set-NetAdapterAdvancedProperty -Name '이더넷' -RegistryKeyword '*LsoV2IPv4' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name '이더넷' -RegistryKeyword '*LsoV2IPv6' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name '이더넷' -RegistryKeyword 'EEELinkAdvertisement' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name '이더넷' -RegistryKeyword 'ULPMode' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name '이더넷' -RegistryKeyword '*SelectiveSuspend' -RegistryValue 0 -NoRestart; Set-NetAdapterAdvancedProperty -Name '이더넷' -RegistryKeyword 'ReduceSpeedOnPowerDown' -RegistryValue 0 -NoRestart; Set-DnsClientServerAddress -InterfaceAlias '이더넷' -ServerAddresses ('192.168.1.1','8.8.8.8','1.1.1.1'); Restart-NetAdapter -Name '이더넷' -Confirm:$false }"
echo 설정 요청이 완료되었습니다.
pause
