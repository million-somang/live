# OpenAI API 키 설정 (본인의 OpenAI API 키로 변경하세요)
OPENAI_API_KEY=your_openai_api_key_here

# 서버 포트 (기본값: 5000)
SERVER_PORT=5000
SERVER_HOST=0.0.0.0

# 외부 클라우드 CSR 쇼핑몰 연동 설정 (로컬 에이전트 단독 운영 시)
MALL_SERVER_URL=http://127.0.0.1:3000
MALL_SYNC_SECRET=
AGENT_ONLY_MODE=0

# 2-도메인 분리 설정 (도메인 1: 홍보 홈페이지 + OBS 스튜디오 / 도메인 2: 독립 쇼핑몰)
STUDIO_PUBLIC_URL=http://localhost:5000
MALL_PUBLIC_URL=http://localhost:3000

# 도메인 1 보안 및 초기 관리자 설정 (미설정 시 난수 자동 생성)
STUDIO_SECRET_KEY=
STUDIO_ADMIN_USERNAME=admin
STUDIO_ADMIN_EMAIL=admin@studio.local
STUDIO_ADMIN_PASSWORD=
STUDIO_DEFAULT_INVITE_CODE=
WEBHOOK_SECRET=
